{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "host-firewall-controller values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "hostRoot": { "type": "string", "pattern": "^/" },
    "ufwPath": { "type": "string", "pattern": "^/" },
    "sweepInterval": { "type": "string", "pattern": "^([0-9]*[1-9][0-9]*(\\.[0-9]+)?|0*\\.[0-9]*[1-9][0-9]*)(ns|us|µs|ms|s|m|h)$" },
    "defaultRefreshInterval": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)$" },
    "minRefreshInterval": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)$" },
    "maxRulesPerNode": { "type": "integer", "minimum": 1 },
    "maxRulesPerCR": { "type": "integer", "minimum": 1 },
    "maxAddresses": { "type": "integer", "minimum": 1, "maximum": 64 },
    "dryRun": { "type": "boolean" },
    "allowMissingUFW": { "type": "boolean" },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "lockPath": { "type": "string" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "updateStrategy": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "resources": { "type": "object" },
    "securityContext": { "type": "object" },
    "healthProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindAddress": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "bindAddress": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "rules": {
      "description": "HostFirewallRule resources keyed by name; each value is the rule spec.",
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  }
}
